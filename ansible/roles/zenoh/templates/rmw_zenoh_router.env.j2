# {{ ansible_managed }}
# Read only by zenoh-router.service. ROS nodes keep rmw_zenoh's default session config
# (connect to the router on localhost), so they must NOT get ZENOH_CONFIG_OVERRIDE.
RUST_LOG={{ zenoh_log_level }}
ZENOH_CONFIG_OVERRIDE='connect/endpoints=[{% for h in zenoh_connect_hosts %}"tcp/{{ hostvars[h].ansible_host }}:{{ zenoh_router_port }}"{{ "," if not loop.last }}{% endfor %}]'
